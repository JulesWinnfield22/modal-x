{
  "name": "@customizer/modal-x",
  "version": "0.4.0",
  "private": false,
  "description": "Lightweight, file-based modal system for Vue 3 with automatic type-safety, Promise-based API, and zero boilerplate. Distributed as source files to allow Vite to perform global file scanning and perfect code-splitting in your project.",
  "keywords": [
    "vue",
    "vue3",
    "modal",
    "dialog",
    "vite",
    "vite-plugin",
    "file-based",
    "typescript",
    "type-safe",
    "promise-api",
    "dx",
    "boilerplate-free"
  ],
  "author": "JulesWinnfield22",
  "license": "MIT",
  "homepage": "https://github.com/JulesWinnfield22/modal-x#readme",
  "bugs": {
    "url": "https://github.com/JulesWinnfield22/modal-x/issues"
  },
  "types": "index.d.ts",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "files": [
    "*.{js,cjs,d.ts,vue,css}",
    "src/**/*.{vue,js}",
    "store/**/*.js",
    "plugins/**/*.js",
    "guards/**/*.js",
    "router/**/*.{js,d.ts}"
  ],
  "scripts": {
    "dev": "vite",
    "test:unit": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JulesWinnfield22/modal-x.git"
  },
  "dependencies": {
    "vue": "^3.3.4"
  },
  "peerDependencies": {
    "vue-router": ">=4"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.3.1",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/test-utils": "^2.4.1",
    "jsdom": "^22.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-router": "^4.2.4"
  }
}
